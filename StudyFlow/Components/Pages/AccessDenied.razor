
@page "/access-denied"
@attribute [AllowAnonymous]

<PageTitle>Access Denied | StudyFlow</PageTitle>

<div style="max-width:600px; margin:100px auto;
            padding:40px; text-align:center;
            border:1px solid #dce7f4; border-radius:16px;">

    <h1 style="color:#15457F;">Access Denied</h1>

    <p>
        You don't have permission to access this page.
        This section is available only to authorized users.
    </p>

    <a href="/dashboard"
       style="display:inline-block; margin-top:20px;
              padding:12px 24px; background:#15457F;
              color:white; border-radius:8px;
              text-decoration:none;">
        Back to Dashboard
    </a>
</div>
