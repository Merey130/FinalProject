@page "/register-backend"
@inject NavigationManager Nav
<PageTitle>Register | StudyFlow</PageTitle>
<div class="container py-5" style="max-width:520px">
  <div class="card shadow-sm border-0 rounded-4 p-4">
    <h1 class="h3 fw-bold" style="color:#16477C">Create account</h1>
    <p class="text-muted">Join StudyFlow and keep your study data private.</p>
    @if (Nav.Uri.Contains("error=", StringComparison.OrdinalIgnoreCase)) { <div class="alert alert-danger">Registration failed. Check your details and Supabase email settings.</div> }
    <form method="post" action="/auth/register">
      <AntiforgeryToken />
      <label class="form-label" for="displayName">Name</label>
      <input class="form-control mb-3" id="displayName" name="displayName" maxlength="100" autocomplete="name" />
      <label class="form-label" for="email">Email</label>
      <input class="form-control mb-3" id="email" name="email" type="email" maxlength="254" autocomplete="email" required />
      <label class="form-label" for="password">Password (minimum 8 characters)</label>
      <input class="form-control mb-3" id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required />
      <label class="form-label" for="confirmPassword">Confirm password</label>
      <input class="form-control mb-3" id="confirmPassword" name="confirmPassword" type="password" minlength="8" maxlength="72" autocomplete="new-password" required />
      <button class="btn w-100 text-white" style="background:#16477C" type="submit">Create account</button>
    </form>
    <p class="mt-3 mb-0">Already registered? <a href="/login">Sign in</a></p>
  </div>
</div>
