
@page "/progress"
@using StudyFlow.Models
@inject StudyFlow.Services.MockExamState ExamState

<PageTitle>My Progress | StudyFlow</PageTitle>

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="p-4 mb-4 text-white rounded-4"
         style="background: linear-gradient(120deg, #071F42, #16477C);">

        <h2 class="fw-bold">My Progress 📊</h2>

        <p class="mb-0">
            Track your ҰБТ mock exam results.
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <p class="text-muted">Latest Score</p>
                <h2>@(Latest?.Total ?? 0) / 140</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <p class="text-muted">Best Score</p>
                <h2>@BestScore / 140</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <p class="text-muted">Score Change</p>
                <h2>@ScoreChangeText</h2>
            </div>
        </div>

    </div>

    <!-- Add Result -->
    <div class="card p-4 shadow-sm mb-4">

        <h4>Add Mock Exam Result</h4>

        <p class="text-muted">
            Demo mode: enter test scores for testing.
        </p>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <div class="row g-3 mt-1">

            <div class="col-md-4">
                <label class="form-label">Test Date</label>

                <input type="date"
                       class="form-control"
                       @bind="testDate" />
            </div>

            <div class="col-md-4">
                <label class="form-label">
                    History of Kazakhstan (20)
                </label>

                <input type="number"
                       min="0"
                       max="20"
                       class="form-control"
                       @bind="history" />
            </div>

            <div class="col-md-4">
                <label class="form-label">
                    Reading Literacy (10)
                </label>

                <input type="number"
                       min="0"
                       max="10"
                       class="form-control"
                       @bind="reading" />
            </div>

            <div class="col-md-4">
                <label class="form-label">
                    Mathematical Literacy (10)
                </label>

                <input type="number"
                       min="0"
                       max="10"
                       class="form-control"
                       @bind="literacy" />
            </div>

            <div class="col-md-4">
                <label class="form-label">
                    Mathematics (50)
                </label>

                <input type="number"
                       min="0"
                       max="50"
                       class="form-control"
                       @bind="math" />
            </div>

            <div class="col-md-4">
                <label class="form-label">
                    Informatics (50)
                </label>

                <input type="number"
                       min="0"
                       max="50"
                       class="form-control"
                       @bind="informatics" />
            </div>

        </div>

        <button type="button"
                class="btn text-white mt-4"
                style="background-color: #16477C;"
                @onclick="AddResult">

            Save Result

        </button>

    </div>

    <!-- Empty State -->
    @if (Results.Count == 0)
    {
        <div class="alert alert-info">
            No mock exam results yet.
            Add your first test result!
        </div>
    }
    else
    {
        <!-- Subject Results -->
        <div class="card p-4 shadow-sm mb-4">

            <h4>Latest Subject Results</h4>

            @foreach (var subject in LatestSubjects)
            {
                <div class="mt-3">

                    <div class="d-flex justify-content-between">
                        <span>@subject.Name</span>

                        <strong>
                            @subject.Score / @subject.Max
                        </strong>
                    </div>

                    <div class="progress mt-2"
                         style="height: 12px;">

                        <div class="progress-bar"
                             style="width: @(subject.Score * 100.0 / subject.Max)%; background-color: #16477C;">
                        </div>

                    </div>

                </div>
            }

        </div>

        <!-- Progress Chart -->
        <div class="card p-4 shadow-sm mb-4">

            <h4>Score Progress</h4>

            <label class="form-label mt-3">
                Choose Subject
            </label>

            <select class="form-select mb-4"
                    @bind="selectedSubject">

                <option value="Total">Total Score</option>
                <option value="History">History of Kazakhstan</option>
                <option value="Reading">Reading Literacy</option>
                <option value="Literacy">Mathematical Literacy</option>
                <option value="Math">Mathematics</option>
                <option value="Informatics">Informatics</option>

            </select>

            @foreach (var exam in OrderedResults)
            {
                <div class="mb-3" @key="exam.Id">

                    <div class="d-flex justify-content-between mb-1">

                        <span>
                            @exam.Date.ToString("dd MMM yyyy")
                        </span>

                        <strong>
                            @GetScore(exam) / @SelectedMax
                        </strong>

                    </div>

                    <div class="progress" style="height: 18px;">

                        <div class="progress-bar"
                             style="width: @(GetScore(exam) * 100.0 / SelectedMax)%; background-color: #16477C;">
                        </div>

                    </div>

                </div>
            }

        </div>

        <!-- Exam History -->
        <div class="card p-4 shadow-sm">

            <h4>Mock Exam History</h4>

            <div class="table-responsive mt-3">

                <table class="table table-striped align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>History</th>
                            <th>Reading</th>
                            <th>Math Literacy</th>
                            <th>Math</th>
                            <th>Informatics</th>
                            <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var exam in OrderedResults)
                        {
                            <tr @key="exam.Id">

                                <td>
                                    @exam.Date.ToString("dd MMM yyyy")
                                </td>

                                <td>@exam.History</td>
                                <td>@exam.Reading</td>
                                <td>@exam.Literacy</td>
                                <td>@exam.Math</td>
                                <td>@exam.Informatics</td>

                                <td>
                                    <strong>@exam.Total / 140</strong>
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            @onclick="() => DeleteResult(exam.Id)">
                                        Delete
                                    </button>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

@code {

    private DateTime testDate = DateTime.Today;

    private int history = 0;
    private int reading = 0;
    private int literacy = 0;
    private int math = 0;
    private int informatics = 0;

    private string errorMessage = "";
    private string selectedSubject = "Total";

    private IReadOnlyList<MockExam> Results =>
        ExamState.Results;

    private List<MockExam> OrderedResults =>
        Results.OrderBy(r => r.Date)
               .ThenBy(r => r.Id)
               .ToList();

    private MockExam? Latest =>
        OrderedResults.LastOrDefault();

    private int BestScore =>
        Results.Count == 0
            ? 0
            : Results.Max(r => r.Total);

    private int ScoreChange =>
        Results.Count < 2
            ? 0
            : OrderedResults[^1].Total
              - OrderedResults[^2].Total;

    private string ScoreChangeText =>
        Results.Count < 2
            ? "—"
            : ScoreChange.ToString("+#;-#;0");

    private IEnumerable<(string Name, int Score, int Max)>
        LatestSubjects
    {
        get
        {
            var r = Latest;

            if (r == null)
            {
                return Array.Empty<
                    (string Name, int Score, int Max)>();
            }

            return new (string Name, int Score, int Max)[]
            {
                ("History of Kazakhstan", r.History, 20),
                ("Reading Literacy", r.Reading, 10),
                ("Mathematical Literacy", r.Literacy, 10),
                ("Mathematics", r.Math, 50),
                ("Informatics", r.Informatics, 50)
            };
        }
    }

    private int SelectedMax => selectedSubject switch
    {
        "History" => 20,
        "Reading" => 10,
        "Literacy" => 10,
        "Math" => 50,
        "Informatics" => 50,
        _ => 140
    };

    private int GetScore(MockExam exam) =>
        selectedSubject switch
        {
            "History" => exam.History,
            "Reading" => exam.Reading,
            "Literacy" => exam.Literacy,
            "Math" => exam.Math,
            "Informatics" => exam.Informatics,
            _ => exam.Total
        };

    private void AddResult()
    {
        errorMessage = "";

        if (testDate == default ||
            testDate.Date > DateTime.Today)
        {
            errorMessage =
                "Please select a valid test date.";

            return;
        }

        if (history < 0 || history > 20 ||
            reading < 0 || reading > 10 ||
            literacy < 0 || literacy > 10 ||
            math < 0 || math > 50 ||
            informatics < 0 || informatics > 50)
        {
            errorMessage =
                "One or more subject scores are invalid.";

            return;
        }

        ExamState.AddResult(new MockExam
        {
            Date = testDate.Date,
            History = history,
            Reading = reading,
            Literacy = literacy,
            Math = math,
            Informatics = informatics
        });

        history = 0;
        reading = 0;
        literacy = 0;
        math = 0;
        informatics = 0;
    }

    private void DeleteResult(int id)
    {
        ExamState.DeleteResult(id);
    }
}
