@page "/login"
@inject NavigationManager Nav
<PageTitle>Login | StudyFlow</PageTitle>
<div class="container py-5" style="max-width:520px">
  <div class="card shadow-sm border-0 rounded-4 p-4">
    <h1 class="h3 fw-bold" style="color:#16477C">Welcome back</h1>
    <p class="text-muted">Sign in to your StudyFlow account.</p>
    @if (Nav.Uri.Contains("error=", StringComparison.OrdinalIgnoreCase)) { <div class="alert alert-danger">Login failed. Check your email and password, or confirm your email address.</div> }
    @if (Nav.Uri.Contains("registered=1", StringComparison.OrdinalIgnoreCase)) { <div class="alert alert-info">Account created. If email confirmation is enabled, confirm your email before signing in.</div> }
    <form method="post" action="/auth/login">
      <AntiforgeryToken />
      <label class="form-label" for="email">Email</label>
      <input class="form-control mb-3" id="email" name="email" type="email" autocomplete="email" required />
      <label class="form-label" for="password">Password</label>
      <input class="form-control mb-3" id="password" name="password" type="password" autocomplete="current-password" required />
      <button class="btn w-100 text-white" style="background:#16477C" type="submit">Sign in</button>
    </form>
    <p class="mt-3 mb-0">Don't have an account? <a href="/register">Register</a></p>
  </div>
</div>
