
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            🎓 StudyFlow
        </a>
    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Dashboard -->
        <div class="nav-item px-3">
            <NavLink class="nav-link"
                     href=""
                     Match="NavLinkMatch.All">
                🏠 Dashboard
            </NavLink>
        </div>

        <!-- My Tasks -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tasks">📚 My Tasks</NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-3">
                    <form method="post" action="/auth/logout">
                        <AntiforgeryToken />
                        <button class="btn btn-outline-light btn-sm" type="submit">Sign out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3"><a class="nav-link" href="/login">Sign in</a></div>
                <div class="nav-item px-3"><a class="nav-link" href="/register">Register</a></div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>

</div>
