
@page "/"

<PageTitle>StudyFlow | Student Dashboard</PageTitle>

<div class="container-fluid py-4">

    <!-- Welcome banner -->
    <div class="p-4 mb-4 text-white rounded-4"
         style="background: linear-gradient(120deg, #071F42, #16477C);">

        <h2 class="fw-bold">My Learning Dashboard 🎓</h2>
        <p class="mb-0">
            Track your progress and achieve your goals!
        </p>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <p class="text-muted">Total Tasks</p>
                <h2>@tasks.Count</h2>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <p class="text-muted">Completed</p>
                <h2>@CompletedCount</h2>
            </div>
        </div>

        <div class="col-12 col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <p class="text-muted">Upcoming</p>
                <h2>@UpcomingCount</h2>
            </div>
        </div>

    </div>

    <!-- Progress -->
    <div class="card p-4 shadow-sm mb-4">
        <h4>Learning Progress</h4>

        <p class="text-muted">
            @CompletedCount of @tasks.Count tasks completed
        </p>

        <div class="progress" style="height: 14px;">
            <div class="progress-bar"
                 style="width: @(Progress)%; background-color: #16477C;">
            </div>
        </div>

        <p class="mt-2 fw-bold">@Progress%</p>
    </div>

    <!-- Add Assignment -->
    <div class="card p-4 shadow-sm mb-4">

        <h4>Add New Assignment</h4>

        <div class="row g-2 mt-2">

            <div class="col-12 col-md-5">
                <input class="form-control"
                       placeholder="Assignment title"
                       @bind="newTitle" />
            </div>

            <div class="col-12 col-md-3">
                <select class="form-select" @bind="newSubject">
                    <option value="Informatics">Informatics</option>
                    <option value="Mathematics">Mathematics</option>
                </select>
            </div>

            <div class="col-12 col-md-2">
                <input type="date"
                       class="form-control"
                       @bind="newDeadline" />
            </div>

            <div class="col-12 col-md-2">
                <button class="btn w-100 text-white"
                        style="background-color: #16477C;"
                        @onclick="AddTask">
                    Add Task
                </button>
            </div>

        </div>
    </div>

    <!-- Assignment List -->
    <h4 class="mb-3">My Assignments</h4>

    @if (tasks.Count == 0)
    {
        <div class="alert alert-info">
            No assignments yet. Add your first task!
        </div>
    }

    @foreach (var task in tasks.OrderBy(t => t.Deadline))
    {
        <div class="card p-3 shadow-sm mb-3">

            <div class="d-flex flex-wrap align-items-center gap-3">

                <input type="checkbox"
                       checked="@task.IsDone"
                       @onchange="() => ToggleTask(task)" />

                <div class="flex-grow-1">

                    <h5 class="mb-1">@task.Title</h5>

                    <small class="text-muted">
                        @task.Subject
                        | Deadline: @task.Deadline.ToString("dd MMM yyyy")
                    </small>

                </div>

                @if (task.IsDone)
                {
                    <span class="badge bg-success">Completed</span>
                }
                else if (task.Deadline.Date < DateTime.Today)
                {
                    <span class="badge bg-danger">Overdue</span>
                }
                else
                {
                    <span class="badge bg-primary">Pending</span>
                }

                <button class="btn btn-outline-danger btn-sm"
                        @onclick="() => RemoveTask(task)">
                    Delete
                </button>

            </div>
        </div>
    }

</div>

@code {
    private string newTitle = "";
    private string newSubject = "Informatics";
    private DateTime newDeadline = DateTime.Today.AddDays(2);

    private List<StudyTask> tasks = new();

    private int CompletedCount =>
        tasks.Count(t => t.IsDone);

    private int UpcomingCount =>
        tasks.Count(t => !t.IsDone &&
            t.Deadline.Date >= DateTime.Today &&
            t.Deadline.Date <= DateTime.Today.AddDays(3));

    private int Progress =>
        tasks.Count == 0
            ? 0
            : CompletedCount * 100 / tasks.Count;

    private void AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTitle))
            return;

        tasks.Add(new StudyTask
        {
            Title = newTitle.Trim(),
            Subject = newSubject,
            Deadline = newDeadline
        });

        newTitle = "";
    }

    private void ToggleTask(StudyTask task)
    {
        task.IsDone = !task.IsDone;
    }

    private void RemoveTask(StudyTask task)
    {
        tasks.Remove(task);
    }

    private class StudyTask
    {
        public string Title { get; set; } = "";
        public string Subject { get; set; } = "";
        public DateTime Deadline { get; set; }
        public bool IsDone { get; set; }
    }
}
