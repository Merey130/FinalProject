
@page "/curator"
@using StudyFlow.Models
@inject StudyFlow.Services.TaskState TaskState
@inject StudyFlow.Services.MockExamState ExamState

<PageTitle>Curator Dashboard | StudyFlow</PageTitle>

<div class="curator-page">

    <header class="curator-header">
        <div>
            <h1>Curator Dashboard</h1>
            <p>Monitor learning progress and support students.</p>
        </div>
        <span class="curator-label">Curator Workspace</span>
    </header>

    <div class="demo-notice">
        Demo preview: student accounts and role-based access
        are not connected yet. Statistics show test data only.
    </div>

    <!-- Statistics -->
    <div class="curator-stats">

        <div class="curator-stat">
            <span>Connected Students</span>
            <h2>0</h2>
            <p>Accounts not connected</p>
        </div>

        <div class="curator-stat">
            <span>Mock Exams</span>
            <h2>@ExamState.Results.Count</h2>
            <p>Recorded practice tests</p>
        </div>

        <div class="curator-stat">
            <span>Pending Tasks</span>
            <h2>@PendingTasks</h2>
            <p>Incomplete assignments</p>
        </div>

        <div class="curator-stat">
            <span>Overdue Tasks</span>
            <h2>@OverdueTasks</h2>
            <p>Past their deadline</p>
        </div>

    </div>

    <div class="curator-grid">

        <!-- Assignment Overview -->
        <section class="curator-card">

            <div class="card-heading">
                <h3>Assignment Overview</h3>
                <p>Current demo data</p>
            </div>

            <div class="overview-grid">

                <div class="overview-item">
                    <span>Completed Tasks</span>
                    <strong>@CompletedTasks</strong>
                </div>

                <div class="overview-item">
                    <span>Total Tasks</span>
                    <strong>@TaskState.Tasks.Count</strong>
                </div>

            </div>

            <div class="completion-heading">
                <span>Completion Rate</span>
                <strong>@CompletionRate%</strong>
            </div>

            <div class="completion-track">
                <div class="completion-fill"
                     style="width: @(CompletionRate)%">
                </div>
            </div>

            <p class="completion-caption">
                @CompletedTasks of @TaskState.Tasks.Count
                assignments completed
            </p>

        </section>

        <!-- Latest Mock Exam -->
        <section class="curator-card">

            <div class="card-heading">
                <h3>Latest Mock Exam</h3>
                <p>Subject performance overview</p>
            </div>

            @if (LatestExam == null)
            {
                <div class="curator-empty">
                    <h4>No results available</h4>
                    <p>Practice exam results will appear here.</p>
                </div>
            }
            else
            {
                <div class="latest-score">
                    <strong>@LatestExam.Total</strong>
                    <span>/ 140 points</span>
                </div>

                <div class="subject-results">
                    @foreach (var subject in LatestSubjects)
                    {
                        <div class="subject-result">

                            <div class="subject-info">
                                <span>@subject.Name</span>
                                <strong>
                                    @subject.Score / @subject.Max
                                </strong>
                            </div>

                            <div class="subject-track">
                                <div class="subject-fill"
                                     style="width: @(subject.Score * 100.0 / subject.Max)%">
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }

        </section>

    </div>

    <!-- Student Monitoring -->
    <section class="curator-card">

        <div class="card-heading">
            <h3>Student Monitoring</h3>
            <p>Overview of assigned students</p>
        </div>

        <div class="student-placeholder">
            <div class="placeholder-icon">
                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     aria-hidden="true">
                    <circle cx="9" cy="8" r="3" />
                    <path d="M3 20v-2a6 6 0 0 1 12 0v2" />
                    <path d="M17 5a3 3 0 0 1 0 6" />
                    <path d="M18 14a5 5 0 0 1 3 5v1" />
                </svg>
            </div>

            <h4>No students connected</h4>
            <p>
                Student accounts and curator assignments
                will appear here after authentication
                and role management are implemented.
            </p>
        </div>

    </section>

    <!-- Recent Mock Exams -->
    <section class="curator-card">

        <div class="card-heading">
            <h3>Recent Mock Exam Results</h3>
            <p>Five most recent practice tests</p>
        </div>

        @if (RecentExams.Count == 0)
        {
            <div class="curator-empty">
                <h4>No mock exams yet</h4>
                <p>There are no recorded results to display.</p>
            </div>
        }
        else
        {
            <div class="curator-table-scroll">

                <table class="curator-table">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>History</th>
                            <th>Reading</th>
                            <th>Math Literacy</th>
                            <th>Mathematics</th>
                            <th>Informatics</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var exam in RecentExams)
                        {
                            <tr @key="exam.Id">
                                <td>
                                    @exam.Date.ToString("dd MMM yyyy")
                                </td>
                                <td>@exam.History / 20</td>
                                <td>@exam.Reading / 10</td>
                                <td>@exam.Literacy / 10</td>
                                <td>@exam.Math / 50</td>
                                <td>@exam.Informatics / 50</td>
                                <td>
                                    <strong>@exam.Total / 140</strong>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        }

    </section>

    <!-- Academic Recommendations -->
    <section class="curator-card">

        <div class="card-heading">
            <h3>Academic Support</h3>
            <p>Recommendations based on available demo data</p>
        </div>

        <div class="recommendations">

            @if (OverdueTasks > 0)
            {
                <div class="recommendation warning">
                    <strong>Assignments need attention</strong>
                    <p>
                        @OverdueTasks assignments are overdue.
                        Review deadlines and plan additional support.
                    </p>
                </div>
            }

            @if (ExamState.Results.Count > 0)
            {
                <div class="recommendation info">
                    <strong>Exam analysis available</strong>
                    <p>
                        Review the latest mock exam results
                        to identify subjects for revision.
                    </p>
                </div>
            }

            @if (OverdueTasks == 0 &&
                 ExamState.Results.Count == 0)
            {
                <div class="recommendation neutral">
                    <strong>No recommendations yet</strong>
                    <p>
                        Recommendations will appear when
                        assignments or exam data are available.
                    </p>
                </div>
            }

        </div>

    </section>

</div>

@code {

    private int CompletedTasks =>
        TaskState.Tasks.Count(t => t.IsDone);

    private int PendingTasks =>
        TaskState.Tasks.Count(t => !t.IsDone);

    private int OverdueTasks =>
        TaskState.Tasks.Count(t =>
            !t.IsDone &&
            t.Deadline.Date < DateTime.Today);

    private int CompletionRate =>
        TaskState.Tasks.Count == 0
            ? 0
            : CompletedTasks * 100 / TaskState.Tasks.Count;

    private MockExam? LatestExam =>
        ExamState.Results
            .OrderByDescending(r => r.Date)
            .ThenByDescending(r => r.Id)
            .FirstOrDefault();

    private List<MockExam> RecentExams =>
        ExamState.Results
            .OrderByDescending(r => r.Date)
            .ThenByDescending(r => r.Id)
            .Take(5)
            .ToList();

    private IEnumerable<(string Name, int Score, int Max)> LatestSubjects
    {
        get
        {
            var exam = LatestExam;

            if (exam == null)
                return Array.Empty<(string Name, int Score, int Max)>();

            return new (string Name, int Score, int Max)[]
            {
                ("History of Kazakhstan", exam.History, 20),
                ("Reading Literacy", exam.Reading, 10),
                ("Mathematical Literacy", exam.Literacy, 10),
                ("Mathematics", exam.Math, 50),
                ("Informatics", exam.Informatics, 50)
            };
        }
    }
}
